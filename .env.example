# ── Copy this file to .env.local and fill in your values ──────────
# .env.local is gitignored — never commit it with real values

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_local_only

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_local_only

# ── JWT signing secrets (minimum 32 characters each) ─────────────
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_xxxx
JWT_REFRESH_SECRET=CHANGE_ME_at_least_64_characters_long_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google OAuth 2.0 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── MinIO (object storage) ────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_local_only

# ── Grafana dashboard ─────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_local_only

# ── Slack alerts (configure during observability milestone) ───────
GRAFANA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME